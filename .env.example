# Скопируйте в .env и заполните значения

# --- База данных ---
# Локально: file:./prisma/dev.db
# На Vercel: libsql://<db-name>-<org>.turso.io (или https://...)
DATABASE_URL="file:./prisma/dev.db"
# Токен Turso (только для облачной базы)
DB_AUTH_TOKEN=""

# --- Auth ---
NEXTAUTH_SECRET="задайте-свой-строкой-минимум-32-символа"
NEXTAUTH_URL="http://localhost:3000"

# --- Шифрование API-ключа AI (строка >= 32 символов) ---
ENCRYPTION_KEY=""

# --- AI (LM Studio локально или внешний OpenAI-совместимый API) ---
AI_BASE_URL="http://localhost:1234/v1"
AI_API_KEY=""
AI_MODEL=""
AI_TEMPERATURE="0.7"
AI_MAX_TOKENS="2048"
AI_TIMEOUT_MS="120000"
